---
layout: null
permalink: /data/blog.json
---
[
{% for note in site.notes %}
  {
    "title": {{ note.title | jsonify }},
    "slug": {{ note.slug | jsonify }},
    "url": {{ note.url | jsonify }},
    "subtitle": {{ note.subtitle | default: "" | jsonify }},
    "image": {{ note.image | default: "" | jsonify }},
    "body": {{ note.content | jsonify }},
    "bodyFormat": "html"
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
